<section class="w3-padding-64" style="background-color: #FAFAFA; border-bottom: 1px solid #E4E4E7;">
  <div class="w3-content" style="max-width:1200px; padding: 16px;">
    
    <div class="w3-row-padding" style="display: flex; align-items: center; flex-wrap: wrap;">
      
      <!-- Left Content Column -->
      <div class="w3-col l7 m12 s12 w3-margin-bottom">
        
        <span class="w3-small" style="font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #52525B; display: block; margin-bottom: 12px;">
          Enterprise Mobile Surveying &amp; Asset Management
        </span>

        <h1 class="heading" style="font-weight: 800; font-size: 2.75rem; line-height: 1.15; color: #09090B; margin-top: 0; margin-bottom: 16px;" data-editable="text" data-type="span" data-prop="heading.heading_text">
          {{heading.heading_text}}
        </h1>
        
        <div class="subheading-text markdown-text" style="font-size: 1.125rem; line-height: 1.6; color: #52525B; margin-bottom: 28px;" data-editable="text" data-type="block" data-prop="subheading.markdown_content">
          {% if subheading.markdown_content %}{{ subheading.markdown_content | renderMarkdown }}{% endif %}
        </div>

        <!-- Action Buttons (Hardcoded Matching Style) -->
        <div class="buttons" style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin-bottom: 32px;">
          
          <!-- Primary Google Blue CTA (Identical to Header) -->
          <a href="/enquiry.htm" class="ps-header-cta" style="font-size: 0.95rem; padding: 10px 22px; display: inline-flex; align-items: center; text-decoration: none;">
            Book Demo <i class="fa-solid fa-arrow-right" style="margin-left: 8px;"></i>
          </a>

          <!-- Secondary Find Out More CTA -->
          <a href="/enquiry.htm" class="ps-hero-secondary-cta">
            <i class="fa-solid fa-envelope" style="margin-right: 8px; color: #2563EB;"></i> Find Out More
          </a>

        </div>

        <!-- Divider Line -->
        <div style="height: 1px; background-color: #E4E4E7; margin-bottom: 24px; width: 100%;"></div>

        <!-- Glassmorphic Sector Anchor Links -->
        <div class="ps-hero-sectors-grid">
          
          <a href="#surveying-practices" class="ps-sector-pill" style="--pill-color: #10B981;">
            <i class="fa-solid fa-briefcase" style="color: #10B981;"></i>
            <span>Surveying Practices</span>
          </a>

          <a href="#housing-associations" class="ps-sector-pill" style="--pill-color: #38BDF8;">
            <i class="fa-solid fa-building-user" style="color: #38BDF8;"></i>
            <span>Housing Associations</span>
          </a>

          <a href="#local-councils" class="ps-sector-pill" style="--pill-color: #F59E0B;">
            <i class="fa-solid fa-landmark" style="color: #F59E0B;"></i>
            <span>Local Councils</span>
          </a>

          <a href="#commercial-fm" class="ps-sector-pill" style="--pill-color: #8B5CF6;">
            <i class="fa-solid fa-screwdriver-wrench" style="color: #8B5CF6;"></i>
            <span>Commercial &amp; FM</span>
          </a>

        </div>

      </div>

      <!-- Right Media Column -->
      <div class="w3-col l5 m12 s12 w3-center w3-margin-bottom">
        <div class="hero-image w3-card w3-round-large" style="background: #FFFFFF; border: 1px solid #E4E4E7; padding: 16px; overflow: hidden;">
          {% if image.image_path %}
            <div data-editable="image" data-prop-src="image.image_path" data-prop-alt="image.alt_text">
              {% include "components/image", image_path: image.image_path, alt_text: image.alt_text, image_sizes: "(max-width: 640px) 320px, (max-width: 960px) 500px, (max-width: 1280px) 640px" %}
            </div>
          {% else %}
            <div class="w3-padding-64" style="color: #71717A;">
              <i class="fa-solid fa-chart-line w3-jumbo" style="color: #000000;"></i>
              <p class="w3-small w3-margin-top">Dashboard Preview</p>
            </div>
          {% endif %}
        </div>
      </div>

    </div>

  </div>
</section>