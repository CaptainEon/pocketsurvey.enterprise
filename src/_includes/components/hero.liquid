<section class="w3-padding-64" style="--headingGradientColor: {{heading.heading_gradient_color}}; background-color: {{background_color | default: '#0F172A'}}; color: #FFFFFF; border-bottom: 1px solid rgba(255,255,255,0.08);">
  <div class="w3-content" style="max-width:1200px; padding: 0 16px;">
    
    <!-- Top Enterprise Tagline -->
    <div class="w3-center w3-margin-bottom">
      <span class="w3-small w3-text-blue" style="font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;">
        Enterprise Mobile Surveying &amp; Compliance
      </span>
    </div>

    <div class="w3-row-padding w3-flex-container" style="display: flex; align-items: center; flex-wrap: wrap;">
      
      <!-- Left Column: Copy & Actions -->
      <div class="w3-col l7 m12 s12 w3-margin-bottom">
        
        <!-- Editable Heading -->
        <h1 class="heading w3-xxlarge" style="font-weight: 800; line-height: 1.2; letter-spacing: -0.5px; margin-top: 0; color: #FFFFFF;" data-editable="text" data-type="span" data-prop="heading.heading_text">
          {{heading.heading_text}}
        </h1>
        
        <!-- Editable Subheading -->
        <div class="subheading-text markdown-text w3-large w3-margin-top" style="color: {{subheading.color | default: '#94A3B8'}}; line-height: 1.6;" data-editable="text" data-type="block" data-prop="subheading.markdown_content">
          {% if subheading.markdown_content %}{{ subheading.markdown_content | renderMarkdown }}{% endif %}
        </div>

        <!-- Editable Action Buttons -->
        <div class="buttons w3-margin-top" style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;" data-editable="array" data-prop="buttons" data-component-key="_type">
          {% for button in buttons %}
            {% assign _buttonType = button._type %}
            <div data-editable="array-item" data-component="{{ button._type }}" data-id="{{ forloop.index0 }}">
              {% includeWith _buttonType, button %}
            </div>
          {% endfor %}
        </div>

        <!-- Key Trust Indicators -->
        <div class="w3-row w3-margin-top w3-padding-16 w3-border-top" style="border-color: rgba(255,255,255,0.08) !important; font-size: 0.85rem; color: #94A3B8;">
          <div class="w3-third s12 w3-margin-bottom">
            <i class="fa-solid fa-check w3-text-blue w3-margin-right"></i>Surveying Practices
          </div>
          <div class="w3-third s12 w3-margin-bottom">
            <i class="fa-solid fa-check w3-text-blue w3-margin-right"></i>Housing Associations
          </div>
          <div class="w3-third s12 w3-margin-bottom">
            <i class="fa-solid fa-check w3-text-blue w3-margin-right"></i>Local Councils
          </div>
        </div>

      </div>

      <!-- Right Column: Editable Media/Image -->
      <div class="w3-col l5 m12 s12 w3-center w3-margin-bottom">
        <div class="hero-image w3-card-4 w3-round-large" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); padding: 12px; overflow: hidden;">
          {% if image.image_path %}
            <div data-editable="image" data-prop-src="image.image_path" data-prop-alt="image.alt_text">
              {% include "components/image", image_path: image.image_path, alt_text: image.alt_text, image_sizes: "(max-width: 640px) 320px, (max-width: 960px) 500px, (max-width: 1280px) 640px" %}
            </div>
          {% else %}
            <!-- Placeholder preview image if no image path is set in CloudCannon -->
            <div class="w3-padding-64 w3-text-gray">
              <i class="fa-solid fa-laptop-code w3-jumbo w3-text-blue"></i>
              <p class="w3-small w3-margin-top">Add an application dashboard preview image in CloudCannon sidebar</p>
            </div>
          {% endif %}
        </div>
      </div>

    </div>

  </div>
</section>