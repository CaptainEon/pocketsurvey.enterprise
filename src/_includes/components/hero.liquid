<section class="w3-padding-64" style="background-color: #FAFAFA; border-bottom: 1px solid #E2E8F0;">
  <div class="w3-content" style="max-width:1200px; padding: 16px;">
    
    <div class="w3-row-padding" style="display: flex; align-items: center; flex-wrap: wrap;">
      
      <!-- Left Content Column -->
      <div class="w3-col l7 m12 s12 w3-margin-bottom">
        
        <span class="w3-small" style="font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #2563EB; display: block; margin-bottom: 12px;">
          Enterprise Mobile Surveying &amp; Asset Management
        </span>

        <h1 class="heading" style="font-weight: 800; font-size: 2.75rem; line-height: 1.15; color: #0F172A; margin-top: 0; margin-bottom: 16px;" data-editable="text" data-type="span" data-prop="heading.heading_text">
          {{heading.heading_text}}
        </h1>
        
        <div class="subheading-text markdown-text" style="font-size: 1.125rem; line-height: 1.6; color: #475569; margin-bottom: 28px;" data-editable="text" data-type="block" data-prop="subheading.markdown_content">
          {% if subheading.markdown_content %}{{ subheading.markdown_content | renderMarkdown }}{% endif %}
        </div>

        <div class="buttons" style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;" data-editable="array" data-prop="buttons" data-component-key="_type">
          {% for button in buttons %}
            {% assign _buttonType = button._type %}
            <div data-editable="array-item" data-component="{{ button._type }}" data-id="{{ forloop.index0 }}">
              {% includeWith _buttonType, button %}
            </div>
          {% endfor %}
        </div>

        <!-- Trust Features -->
        <div class="w3-row w3-margin-top w3-padding-16" style="border-top: 1px solid #E2E8F0; font-size: 0.875rem; color: #475569; font-weight: 500;">
          <div class="w3-third s12 w3-margin-bottom">
            <i class="fa-solid fa-circle-check w3-margin-right" style="color: #2563EB;"></i>Surveying Practices
          </div>
          <div class="w3-third s12 w3-margin-bottom">
            <i class="fa-solid fa-circle-check w3-margin-right" style="color: #2563EB;"></i>Housing Associations
          </div>
          <div class="w3-third s12 w3-margin-bottom">
            <i class="fa-solid fa-circle-check w3-margin-right" style="color: #2563EB;"></i>Local Councils
          </div>
        </div>

      </div>

      <!-- Right Media Column -->
      <div class="w3-col l5 m12 s12 w3-center w3-margin-bottom">
        <div class="hero-image w3-card w3-round-large" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 16px; overflow: hidden;">
          {% if image.image_path %}
            <div data-editable="image" data-prop-src="image.image_path" data-prop-alt="image.alt_text">
              {% include "components/image", image_path: image.image_path, alt_text: image.alt_text, image_sizes: "(max-width: 640px) 320px, (max-width: 960px) 500px, (max-width: 1280px) 640px" %}
            </div>
          {% else %}
            <div class="w3-padding-64" style="color: #94A3B8;">
              <i class="fa-solid fa-chart-line w3-jumbo" style="color: #2563EB;"></i>
              <p class="w3-small w3-margin-top">Dashboard Preview</p>
            </div>
          {% endif %}
        </div>
      </div>

    </div>

  </div>
</section>