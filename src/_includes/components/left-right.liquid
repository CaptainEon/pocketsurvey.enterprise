{% comment %} Ensure an ID always exists: use id_anchor if present, otherwise auto-slugify the heading {% endcomment %}
{% assign section_id = id_anchor %}
{% if section_id == blank or section_id == null %}
  {% assign section_id = heading.heading_text | downcase | replace: ' ', '-' | replace: '&', '' | replace: '--', '-' %}
{% endif %}

<section id="{{ section_id }}" class="w3-padding-64" style="background-color: {{ background_color | default: '#ffffff' }}; border-bottom: 1px solid #E4E4E7; scroll-margin-top: 90px; position: relative;">
  <div class="w3-content" style="max-width: 1200px; padding: 0 24px;">
    
    <div class="ps-left-right-wrapper {% if flipped %}is-flipped{% endif %}">
      
      <!-- Text Column (Always Order 1 on Mobile) -->
      <div class="ps-lr-content">
        <h2 style="font-size: 2.25rem; font-weight: 800; color: {{ heading.color | default: '#0F172A' }}; margin-top: 0; margin-bottom: 20px; line-height: 1.2;">
          {{ heading.heading_text }}
        </h2>

        <div class="markdown-text" style="font-size: 1.05rem; line-height: 1.65; color: {{ text.color | default: '#334155' }}; margin-bottom: 28px;">
          {% if text.markdown_content %}{{ text.markdown_content | renderMarkdown }}{% endif %}
        </div>

        {% if button.button_link != blank %}
          <a href="{{ button.button_link }}" class="ps-header-cta" style="font-size: 0.95rem; padding: 10px 22px; display: inline-flex; align-items: center; text-decoration: none;">
            {{ button.button_text }} <i class="{{ button.button_icon | default: 'fa-solid fa-arrow-right' }}" style="margin-left: 8px;"></i>
          </a>
        {% endif %}
      </div>

      <!-- Image Column (Always Order 2 on Mobile) -->
      <div class="ps-lr-image">
        <div class="w3-card w3-round-large" style="background: #FFFFFF; border: 1px solid #E4E4E7; padding: 16px; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);">
          {% include "components/image", image_path: image.image_path, alt_text: image.alt_text %}
        </div>
      </div>

    </div>

  </div>
</section>